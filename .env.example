# ============================================================
# Variables de entorno del FRONTEND — Materia Prima
# ============================================================
#
# IMPORTANTE: Todas las variables VITE_* son públicas y visibles
# en el navegador. NUNCA incluir secretos, contraseñas ni tokens
# privados en este archivo (SKILL.md §28).
#
# Copia este archivo como .env.local para desarrollo local:
#   cp .env.example .env.local
#
# NOTA PARA DESPLIEGUE EN NETLIFY:
# Configurar VITE_API_BASE_URL en el panel de Netlify:
# Site configuration > Environment variables > Add a variable
#
# Ejemplo local:
# VITE_API_BASE_URL=http://localhost:3000/api/v1
#
# Ejemplo producción (debe apuntar al dominio público donde esté alojada la API e incluir /api/v1):
# VITE_API_BASE_URL=https://api.tu-dominio.com/api/v1
# ============================================================

VITE_API_BASE_URL=http://localhost:3000/api/v1
