# Headers de caché para Netlify (PWA y Assets Inmutables)

# 1. Service Worker, registro y manifiesto: NUNCA en caché del navegador ni CDN para garantizar actualizaciones instantáneas
/sw.js
  Cache-Control: max-age=0, no-cache, no-store, must-revalidate

/registerSW.js
  Cache-Control: max-age=0, no-cache, no-store, must-revalidate

/manifest.webmanifest
  Cache-Control: max-age=0, no-cache, no-store, must-revalidate

# 2. HTML principal: revalidación continua (ETag) para detectar de inmediato nuevas rutas y bundles generados
/index.html
  Cache-Control: no-cache, must-revalidate

# 3. Chunks estáticos con hash único generados por Vite: caché inmutable y de larga duración
/assets/*
  Cache-Control: public, max-age=31536000, immutable
